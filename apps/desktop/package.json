{
  "name": "@line/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Line: app de chat e comunidades (interface Next.js + casco Tauri em Rust)",
  "author": "Line",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "node scripts/copy-noise.mjs && next dev -p 3000",
    "build:web": "node scripts/copy-noise.mjs && next build",
    "build": "tauri build --no-bundle",
    "dist:win": "tauri build --bundles nsis",
    "dist:linux": "tauri build --bundles deb",
    "tauri": "tauri",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@line/shared": "0.1.0",
    "@sapphi-red/web-noise-suppressor": "^0.4.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io-client": "^4.8.4",
    "tailwindcss": "^4.3.4",
    "zustand": "^5.0.16"
  },
  "dependencies": {
    "lucide-react": "^0.468.0"
  }
}
