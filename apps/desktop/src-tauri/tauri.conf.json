{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Line",
  "version": "0.1.0",
  "identifier": "app.line.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Line: chat e comunidades",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ],
        "section": "net"
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM0NzExMEI2Njg4MTI5RTEKUldUaEtZRm90aEJ4TkVKSHMzdHBVWHZQTm1ENHNHbnFSM05xM2QyYUJaUk03ek1XaHB4c3djZ0UK",
      "endpoints": [
        "https://useline.tech/updates/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
